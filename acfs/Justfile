set working-directory := './'

# Module-local recipes for ACFS. Formatting, linting, vetting, and tests for
# every module in this repository run from the root Justfile.

_default:
    @just --list

[group('test')]
benchmark:
    go test -run '^$' -bench 'Benchmark(List|ReadTo|WriteFrom)' -benchmem .

[group('release')]
release-check:
    goreleaser check

[group('release')]
snapshot:
    goreleaser release --snapshot --clean

# Create and push a new ACFS version tag (acfs/vX.Y.Z).
#
# Usage:
#   just release          # auto-increments patch from latest acfs/v* tag
#   just release 1.2.3    # explicit version
[group('release')]
release version="":
    #!/usr/bin/env bash
    set -euo pipefail

    if [ -z "{{ version }}" ]; then
        LATEST_TAG=$(git tag -l 'acfs/v*' --sort=-v:refname | head -n1 || echo "")
        if [ -z "$LATEST_TAG" ]; then
            echo "No existing tag found; defaulting to acfs/v0.0.1"
            NEW_VERSION="0.0.1"
        else
            VERSION="${LATEST_TAG#acfs/v}"
            IFS='.' read -r MAJOR MINOR PATCH <<< "$VERSION"
            NEW_PATCH=$((PATCH + 1))
            NEW_VERSION="${MAJOR}.${MINOR}.${NEW_PATCH}"
        fi
    else
        NEW_VERSION="{{ version }}"
    fi

    echo "==> Tagging acfs/v${NEW_VERSION}"
    git tag "acfs/v${NEW_VERSION}" -m "acfs/v${NEW_VERSION}"
    git push origin "acfs/v${NEW_VERSION}"
    echo "==> Pushed acfs/v${NEW_VERSION}"
